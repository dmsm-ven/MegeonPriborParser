<Window
    x:Class="MegeonParserDesktop.ConflictResolverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MegeonParserDesktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ConflictResolverWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox x:Name="lbAvailableVariants" Grid.Row="0" />
        <DockPanel
            Grid.Row="1"
            Margin="2"
            LastChildFill="True">
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Text="Custom URL" />
            <Button
                x:Name="btnCustomUrl"
                VerticalAlignment="Center"
                Click="btnCustomUrl_Click"
                Content="Use Custom URL"
                DockPanel.Dock="Right" />
            <TextBox x:Name="txtCustomUrl" Margin="4,0" />
        </DockPanel>
        <Button
            x:Name="btnSelect"
            Grid.Row="2"
            Click="btnSelect_Click"
            Content="Select" />
    </Grid>
</Window>
